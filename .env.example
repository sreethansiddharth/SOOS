# =======================================================
# Serverless Order Orchestration - Environment Variables
# NEVER commit real credentials, secret keys, or AWS tokens.
# =======================================================

# Frontend Config
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_USE_MOCKS=true

# AWS Deployment Configuration
AWS_REGION=ap-south-1
ENVIRONMENT=dev

# DynamoDB Logical Tables
PRODUCTS_TABLE=aether-products-dev
INVENTORY_TABLE=aether-inventory-dev
ORDERS_TABLE=aether-orders-dev
ORDER_EVENTS_TABLE=aether-order-events-dev
IDEMPOTENCY_TABLE=aether-idempotency-dev
PAYMENTS_TABLE=aether-payments-dev

# Workflow & Messaging ARNs
ORDER_STATE_MACHINE_ARN=arn:aws:states:ap-south-1:123456789012:stateMachine:aether-order-orchestration-dev
ORDER_EVENTS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:aether-order-events-dev
BACKGROUND_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/aether-fulfillment-queue-dev.fifo

# S3 Buckets
INVOICE_BUCKET=aether-invoices-private-dev
ASSETS_BUCKET=aether-product-assets-dev

# API & Security
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
FAULT_INJECTION_ENABLED=false
